{
  "schema": "canon-neu/components/v1",
  "workflow": "README.md",
  "steps": {
    "DISCOVER": {
      "command": [
        "{python}",
        "{package}/../native-adapter/run.py",
        "{canon}",
        "{wolframscript}",
        "blade",
        "{package}"
      ],
      "instructions": "README.md",
      "interface": {
        "inputs": [
          "backend"
        ],
        "alternatives": [
          [
            "reducer_family"
          ],
          [
            "prepared_family"
          ]
        ],
        "outputs": [
          "master_basis",
          "sector_manifest"
        ],
        "scope": "Normalize an explicit native master catalogue; import or declared native commands."
      }
    },
    "REDUCE_IBP": {
      "command": [
        "{python}",
        "{package}/../native-adapter/run.py",
        "{canon}",
        "{wolframscript}",
        "blade",
        "{package}"
      ],
      "instructions": "README.md",
      "interface": {
        "inputs": [
          "backend",
          "reduction_targets"
        ],
        "alternatives": [
          [
            "reducer_family"
          ],
          [
            "prepared_family"
          ]
        ],
        "optional_inputs": [
          "master_basis",
          "basis_conversion"
        ],
        "outputs": [
          "ibp_reduction"
        ],
        "scope": "Normalize solved exact rules with complete declared target coverage."
      }
    },
    "BUILD_CUT_DE": {
      "command": [
        "{python}",
        "{package}/../native-adapter/run.py",
        "{canon}",
        "{wolframscript}",
        "blade",
        "{package}"
      ],
      "instructions": "README.md",
      "interface": {
        "inputs": [
          "backend",
          "master_basis",
          "sector_manifest"
        ],
        "alternatives": [
          [
            "reducer_family"
          ],
          [
            "prepared_family"
          ]
        ],
        "optional_inputs": [
          "basis_conversion"
        ],
        "outputs": [
          "ordered_master_de",
          "sector_basis",
          "sector_cut_de"
        ],
        "scope": "Normalize a full symbolic native DE export and extract its sector."
      }
    }
  }
}
